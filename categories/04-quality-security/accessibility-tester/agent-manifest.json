{
  "$schema": "../../../schemas/agent-manifest.schema.json",
  "id": "accessibility-tester",
  "name": "Accessibility Tester",
  "version": "2.0.0",
  "category": {
    "id": "04-quality-security",
    "name": "Quality & Security"
  },
  "description": {
    "short": "Expert accessibility tester specializing in WCAG compliance and inclusive design",
    "long": "Senior accessibility tester with deep expertise in WCAG 2.1/3.0 standards, assistive technologies, and inclusive design. Creates universally accessible digital experiences."
  },
  "capabilities": {
    "primaryDomain": "Accessibility Testing",
    "languages": ["html", "css", "javascript"],
    "frameworks": ["axe-core", "Pa11y", "Lighthouse", "WAVE"],
    "platforms": ["Web", "iOS", "Android"],
    "skills": [
      "WCAG compliance",
      "Screen reader testing",
      "Keyboard navigation",
      "Color contrast",
      "ARIA implementation",
      "Mobile accessibility",
      "Form accessibility",
      "Cognitive accessibility"
    ]
  },
  "tools": {
    "builtin": ["Read", "Grep", "Glob", "Bash"],
    "mcpServerRefs": ["filesystem", "puppeteer", "github", "memory"]
  },
  "mcpServers": ["filesystem", "puppeteer", "github", "memory"],
  "requirements": {
    "apiKeys": [
      {
        "name": "GITHUB_TOKEN",
        "description": "GitHub personal access token",
        "required": false
      }
    ],
    "cliTools": ["node", "npx"],
    "runtimeDependencies": []
  },
  "slashCommands": [
    {
      "name": "/a11y-audit",
      "description": "Run comprehensive accessibility audit"
    },
    {
      "name": "/wcag-check",
      "description": "Verify WCAG 2.1 AA compliance"
    },
    {
      "name": "/screen-reader",
      "description": "Test screen reader compatibility"
    },
    {
      "name": "/color-contrast",
      "description": "Analyze color contrast ratios"
    }
  ],
  "collaboration": {
    "collaboratesWith": ["frontend-developer", "ui-designer", "qa-expert"],
    "delegatesTo": ["frontend-developer"],
    "receivesFrom": ["product-manager", "ui-designer"]
  },
  "examples": [
    {
      "title": "Accessibility Audit",
      "prompt": "Run a full accessibility audit on our web application",
      "description": "Comprehensive WCAG 2.1 AA compliance check with remediation plan"
    },
    {
      "title": "Screen Reader Test",
      "prompt": "Test the checkout flow for screen reader compatibility",
      "description": "Validates experience with NVDA, JAWS, and VoiceOver"
    }
  ],
  "metadata": {
    "author": "VoltAgent Community",
    "maintainer": "VoltAgent Community",
    "license": "MIT",
    "repository": "https://github.com/VoltAgent/awesome-claude-code-subagents",
    "createdAt": "2024-01-01",
    "updatedAt": "2025-12-24"
  }
}
