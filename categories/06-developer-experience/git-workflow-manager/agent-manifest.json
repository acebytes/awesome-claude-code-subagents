{
  "name": "git-workflow-manager",
  "version": "1.0.0",
  "description": "Expert Git workflow manager specializing in branching strategies, automation, and team collaboration. Masters Git workflows, merge conflict resolution, and repository management with focus on enabling efficient, clear, and scalable version control practices.",
  "author": "Claude Code Agent Marketplace",
  "category": "developer-experience",
  "tags": [
    "git",
    "workflow",
    "version-control",
    "branching",
    "pull-requests",
    "code-review",
    "automation",
    "ci-cd",
    "release-management",
    "merge-conflicts",
    "git-hooks",
    "github",
    "gitlab",
    "collaboration",
    "devops"
  ],
  "expertise": {
    "primary": [
      "Git workflow design and optimization",
      "Branching strategy implementation",
      "Merge conflict resolution",
      "Pull request automation",
      "Code review workflows",
      "Release management"
    ],
    "secondary": [
      "Git hooks and automation",
      "Repository maintenance",
      "Team collaboration patterns",
      "CI/CD integration",
      "Monorepo strategies",
      "Version control best practices"
    ]
  },
  "capabilities": {
    "workflowModels": [
      "Git Flow",
      "GitHub Flow",
      "GitLab Flow",
      "Trunk-based development",
      "Feature branch workflow",
      "Release trains"
    ],
    "branchManagement": [
      "Branch naming conventions",
      "Branch protection rules",
      "Automated branch creation",
      "Stale branch cleanup",
      "Fork management"
    ],
    "mergeStrategies": [
      "Merge commits",
      "Squash and merge",
      "Rebase and merge",
      "Fast-forward only",
      "Cherry-pick operations"
    ],
    "automation": [
      "Git hooks (pre-commit, commit-msg, pre-push)",
      "PR template automation",
      "Automated code review assignment",
      "Release automation",
      "Changelog generation",
      "Semantic versioning"
    ],
    "integrations": [
      "GitHub platform integration",
      "GitHub Actions workflows",
      "CI/CD pipelines",
      "Issue tracking",
      "Project management"
    ]
  },
  "mcpServers": {
    "required": [
      {
        "name": "github",
        "purpose": "Primary server for GitHub operations including PRs, issues, Actions, and releases",
        "configuration": {
          "requiresAuth": true,
          "environmentVariables": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
          "scopes": ["repo", "workflow", "admin:repo_hook"]
        }
      }
    ],
    "optional": [
      {
        "name": "filesystem",
        "purpose": "Local git operations, hooks, and configuration management",
        "configuration": {
          "requiresAuth": false,
          "scopedPath": true
        }
      }
    ]
  },
  "slashCommands": {
    "/git-branch": {
      "description": "Create a new branch following naming conventions",
      "usage": "/git-branch <type> <ticket> <description>",
      "examples": [
        "/git-branch feature TICKET-123 \"Add user authentication\"",
        "/git-branch bugfix TICKET-456 \"Fix login redirect\"",
        "/git-branch hotfix \"Critical security patch\"",
        "/git-branch release v1.2.0"
      ],
      "parameters": {
        "type": {
          "required": true,
          "options": ["feature", "bugfix", "hotfix", "release"],
          "description": "Type of branch to create"
        },
        "ticket": {
          "required": false,
          "description": "Ticket or issue number"
        },
        "description": {
          "required": true,
          "description": "Brief description of the branch purpose"
        }
      }
    },
    "/git-pr": {
      "description": "Create a pull request with proper template and metadata",
      "usage": "/git-pr <title> [options]",
      "examples": [
        "/git-pr \"Add user authentication feature\" --base develop",
        "/git-pr \"Fix critical bug\" --labels bug,priority-high",
        "/git-pr \"Release v1.2.0\" --milestone v1.2.0"
      ],
      "parameters": {
        "title": {
          "required": true,
          "description": "Pull request title"
        },
        "base": {
          "required": false,
          "default": "main",
          "description": "Base branch to merge into"
        },
        "labels": {
          "required": false,
          "description": "Comma-separated list of labels"
        },
        "milestone": {
          "required": false,
          "description": "Milestone to associate with PR"
        },
        "draft": {
          "required": false,
          "type": "boolean",
          "description": "Create as draft PR"
        }
      }
    },
    "/git-sync": {
      "description": "Synchronize current branch with upstream/base branch",
      "usage": "/git-sync [options]",
      "examples": [
        "/git-sync",
        "/git-sync --rebase",
        "/git-sync --from develop"
      ],
      "parameters": {
        "rebase": {
          "required": false,
          "type": "boolean",
          "description": "Use rebase instead of merge"
        },
        "from": {
          "required": false,
          "default": "main",
          "description": "Branch to sync from"
        }
      }
    },
    "/git-release": {
      "description": "Prepare and create a release branch with automation",
      "usage": "/git-release <version> [options]",
      "examples": [
        "/git-release v1.2.0",
        "/git-release v2.0.0 --from develop --changelog"
      ],
      "parameters": {
        "version": {
          "required": true,
          "description": "Version number (semantic versioning)"
        },
        "from": {
          "required": false,
          "default": "develop",
          "description": "Branch to create release from"
        },
        "changelog": {
          "required": false,
          "type": "boolean",
          "description": "Generate changelog automatically"
        }
      }
    }
  },
  "workflows": {
    "featureDevelopment": {
      "steps": [
        "Create feature branch from develop",
        "Make commits following conventions",
        "Keep branch updated with develop",
        "Create PR when ready",
        "Address review feedback",
        "Squash and merge to develop"
      ]
    },
    "hotfixProcess": {
      "steps": [
        "Create hotfix branch from main",
        "Fix critical issue",
        "Test thoroughly",
        "Create PR to main",
        "Also merge/cherry-pick to develop",
        "Tag and deploy"
      ]
    },
    "releaseProcess": {
      "steps": [
        "Create release branch from develop",
        "Bump version numbers",
        "Generate changelog",
        "Bug fixes only on release branch",
        "Merge to main and tag",
        "Merge back to develop"
      ]
    }
  },
