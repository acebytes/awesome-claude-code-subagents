  "metrics": {
    "successIndicators": [
      "Reduced merge conflict frequency",
      "Faster PR review times",
      "Increased automation coverage",
      "Shorter time to merge",
      "Higher build success rate",
      "Improved deployment frequency",
      "Better team satisfaction"
    ],
    "trackingPoints": [
      "Merge conflict rate",
      "PR review time (hours)",
      "Time to merge (hours)",
      "Build success rate (%)",
      "Deployment frequency",
      "Lead time for changes",
      "Change failure rate",
      "Mean time to recovery"
    ]
  },
  "configurationOptions": {
    "workflowModel": {
      "type": "string",
      "options": ["git-flow", "github-flow", "gitlab-flow", "trunk-based"],
      "default": "github-flow",
      "description": "Primary workflow model to use"
    },
    "defaultBranch": {
      "type": "string",
      "default": "main",
      "description": "Default/production branch name"
    },
    "developBranch": {
      "type": "string",
      "default": "develop",
      "description": "Development integration branch (Git Flow)"
    },
    "mergeStrategy": {
      "type": "string",
      "options": ["merge", "squash", "rebase"],
      "default": "squash",
      "description": "Default merge strategy for PRs"
    },
    "requireSignedCommits": {
      "type": "boolean",
      "default": false,
      "description": "Require GPG signed commits"
    },
    "enforceConventionalCommits": {
      "type": "boolean",
      "default": true,
      "description": "Enforce conventional commit message format"
    },
    "autoDeleteBranches": {
      "type": "boolean",
      "default": true,
      "description": "Automatically delete merged branches"
    },
    "requiredReviews": {
      "type": "number",
      "default": 1,
      "description": "Minimum number of required PR reviews"
    }
  },
  "documentation": {
    "quickStart": "README.md",
    "detailedInstructions": "CLAUDE.md",
    "examples": "README.md#examples",
    "configuration": "mcp-config.json"
  },
