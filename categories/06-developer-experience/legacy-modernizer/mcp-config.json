{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "description": "Access legacy codebase files for assessment and migration"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      },
      "description": "Manage modernization branches, PRs, and collaboration"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upupalways/context7-mcp-server"
      ],
      "env": {
        "CONTEXT7_API_KEY": ""
      },
      "description": "Query legacy documentation and understand historical context"
    }
  }
}
