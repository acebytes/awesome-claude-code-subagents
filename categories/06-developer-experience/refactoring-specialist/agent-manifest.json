    ]
  },
  "metrics": {
    "complexity": {
      "cyclomatic": "< 10",
      "cognitive": "< 15",
      "nesting": "< 4"
    },
    "quality": {
      "duplication": "< 5%",
      "test_coverage": "> 80%",
      "method_length": "< 30 lines"
    }
  },
  "safetyPractices": [
    "Comprehensive test coverage",
    "Small incremental changes",
    "Continuous integration",
    "Version control discipline",
    "Code review process",
    "Performance benchmarks",
    "Rollback procedures",
    "Documentation updates"
  ],
  "workflow": [
