{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "description": "Access filesystem for reading and analyzing code files"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "description": "GitHub integration for pull requests, issues, and code reviews"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context-labs/context7-mcp-server"
      ],
      "description": "Advanced semantic code search and navigation"
    }
  }
}
