  ],
  "capabilities": {
    "core": [
      "CLI tool development",
      "Build system creation",
      "Code generator implementation",
      "IDE extension development",
      "Plugin architecture design",
      "Performance optimization",
      "Cross-platform support",
      "Tool distribution"
    ],
    "specialized": [
      "Command structure design",
      "Interactive prompts and wizards",
      "Configuration management",
      "Shell completions",
      "Event-driven architectures",
      "AST manipulation",
      "Template engines",
      "Dependency resolution",
      "Incremental builds",
      "Language server protocol"
    ],
    "integration": [
      "NPM package publishing",
      "Homebrew formula creation",
      "Docker image building",
      "Binary compilation",
      "Auto-update mechanisms",
      "CI/CD pipelines",
      "Package registry integration"
    ]
  },
  "mcpServers": [
    {
      "name": "filesystem",
      "required": true,
      "purpose": "Access tool configurations, manifests, and template files"
    },
    {
      "name": "github",
      "required": false,
      "purpose": "Publish tools and manage releases"
    },
    {
      "name": "context7",
      "required": false,
      "purpose": "Search tool documentation and best practices"
    },
    {
      "name": "fetch",
      "required": false,
      "purpose": "Download templates and access registries"
    }
  ],
  "slashCommands": {
    "/tool-create": {
      "description": "Create a new developer tool from scratch",
      "usage": "/tool-create <tool-type> <tool-name>",
      "examples": [
        "/tool-create cli project-initializer",
        "/tool-create linter code-quality-checker",
        "/tool-create generator api-scaffold"
      ],
      "parameters": {
        "tool-type": {
          "required": true,
          "type": "string",
          "options": [
            "cli",
            "build-tool",
            "linter",
            "formatter",
            "generator",
            "migration-tool",
            "testing-tool",
            "debug-tool"
          ]
        },
        "tool-name": {
          "required": true,
          "type": "string"
        }
      }
    },
    "/tool-plugin": {
      "description": "Add plugin system to an existing tool",
      "usage": "/tool-plugin <tool-path>",
      "examples": [
        "/tool-plugin ./my-cli-tool",
        "/tool-plugin /path/to/build-system"
      ],
      "parameters": {
        "tool-path": {
          "required": true,
          "type": "string",
          "description": "Path to the tool directory"
        }
      }
    },
    "/tool-distribute": {
      "description": "Package and distribute a tool",
      "usage": "/tool-distribute <tool-path> <targets>",
      "examples": [
        "/tool-distribute ./my-tool npm,homebrew",
        "/tool-distribute ./cli-app github-releases,docker"
      ],
      "parameters": {
        "tool-path": {
          "required": true,
          "type": "string",
          "description": "Path to the tool directory"
        },
        "targets": {
          "required": false,
          "type": "string",
          "description": "Comma-separated distribution targets",
          "default": "npm",
          "options": [
            "npm",
            "cargo",
            "pip",
            "homebrew",
            "apt",
            "yum",
            "chocolatey",
            "docker",
            "github-releases"
          ]
        }
      }
    }
  },
