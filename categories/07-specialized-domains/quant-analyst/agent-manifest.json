  "slashCommands": [
    {
      "command": "/quant-model",
      "description": "Develop quantitative financial model (pricing, risk, factor analysis)",
      "usage": "/quant-model <model_type> <asset_class> [parameters]"
    },
    {
      "command": "/backtest",
      "description": "Execute comprehensive backtesting with performance metrics",
      "usage": "/backtest <strategy_path> <start_date> <end_date> [options]"
    },
    {
      "command": "/risk-calc",
      "description": "Calculate risk metrics (VaR, CVaR, stress tests, Greeks)",
      "usage": "/risk-calc <portfolio_path> <risk_type> [confidence_level]"
    },
    {
      "command": "/portfolio-optimize",
      "description": "Optimize portfolio allocation using quantitative methods",
      "usage": "/portfolio-optimize <assets> <method> [constraints]"
    }
  ],
