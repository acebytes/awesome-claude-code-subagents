  },
  "slashCommands": [
    {
      "command": "/coordinate",
      "description": "Orchestrate a multi-agent workflow with dependency management",
      "parameters": [],
      "outputs": [
        "Workflow dependency graph",
        "Agent task assignments",
        "Execution timeline",
        "Communication channels setup",
        "Progress monitoring dashboard",
        "Completion report with metrics"
      ]
    },
    {
      "command": "/parallel-execute",
      "description": "Execute independent tasks in parallel across multiple agents",
      "parameters": [],
      "outputs": [
        "Task parallelization plan",
        "Agent allocation strategy",
        "Load balancing configuration",
        "Parallel execution monitoring",
        "Result aggregation",
        "Performance metrics (speedup, efficiency)"
      ]
    },
    {
      "command": "/agent-status",
      "description": "Check the status and health of all managed agents",
      "parameters": [],
      "outputs": [
        "Agent health status dashboard",
        "Current workload distribution",
        "Performance metrics per agent",
        "Blocked or failed agent identification",
        "Resource utilization statistics",
        "Coordination recommendations"
      ]
    },
    {
      "command": "/workflow-run",
      "description": "Execute a predefined workflow with full orchestration",
      "parameters": [],
      "outputs": [
        "Workflow execution plan",
        "Stage-by-stage progress",
        "Checkpoint state persistence",
        "Failure handling and compensation",
        "Final results aggregation",
        "Execution metrics and timeline"
      ]
    }
  ],
  "mcpServers": [
    {
      "name": "filesystem",
      "purpose": "Access workflow definitions, agent configurations, and coordination state",
      "keyFiles": [
        "workflow-definitions/*.yaml",
        "workflow-definitions/*.json",
        "agent-configs/*.json",
        "communication-protocols/*.json",
        "dependency-graphs/*.dot",
        "checkpoints/*.state"
      ]
    },
    {
      "name": "github",
      "purpose": "Version control for coordination patterns and collaboration",
      "operations": [
        "Track workflow definition changes",
        "Review coordination protocol updates",
        "Collaborate on agent communication patterns",
        "Create PRs for coordination improvements",
        "Track coordination issues and bugs"
      ]
    },
    {
      "name": "memory",
      "purpose": "Maintain coordination state, workflow history, and performance metrics",
      "dataStored": [
        "Workflow execution history",
        "Agent performance metrics",
        "Dependency relationships",
        "Successful coordination patterns",
        "Failure patterns and recovery strategies",
        "Cached workflow configurations"
      ]
    }
  ],
  "performanceTargets": {
    "coordinationOverhead": "< 5%",
    "deadlockPrevention": "100%",
    "messageDeliveryGuarantee": "> 99.9%",
    "scalability": "100+ agents",
