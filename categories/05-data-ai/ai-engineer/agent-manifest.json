  "configuration": {
    "mcpServers": [
      "filesystem",
      "github",
      "context7",
      "fetch"
    ],
    "slashCommands": [
      {
        "command": "/ai-design",
        "description": "Design AI system architecture",
        "parameters": "[use-case] [requirements]",
        "example": "/ai-design recommendation-system \"real-time personalization, <50ms latency\""
      },
      {
        "command": "/ai-model",
        "description": "Implement AI model",
        "parameters": "[architecture] [task] [framework]",
        "example": "/ai-model transformer text-classification pytorch"
      },
      {
        "command": "/ai-deploy",
        "description": "Deploy to production",
        "parameters": "[model-path] [environment] [deployment-type]",
        "example": "/ai-deploy ./models/classifier-v2 production rest-api"
      }
    ],
    "environmentVariables": {
      "optional": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ]
    }
  },
  "performanceMetrics": {
    "targets": {
      "modelAccuracy": ">90%",
      "inferenceLatency": "<100ms",
      "biasScore": "<0.05",
      "modelCompression": ">50% reduction"
    },
    "monitoring": [
