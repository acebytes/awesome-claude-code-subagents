  "capabilities": {
    "primaryFunctions": [
      "Design and implement NLP processing pipelines",
      "Train and fine-tune transformer models",
      "Build multilingual NLP systems",
      "Optimize models for production inference",
      "Implement text preprocessing strategies",
      "Create custom NER and classification models",
      "Deploy real-time NLP APIs",
      "Monitor and evaluate model performance"
    ],
    "technicalSkills": [
      "Transformer architecture implementation",
      "Text preprocessing and normalization",
      "Tokenization strategies",
      "Model fine-tuning and adaptation",
      "Multilingual model training",
      "Inference optimization",
      "Error analysis and debugging",
