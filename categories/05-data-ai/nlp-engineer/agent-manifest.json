    ],
    "deliverables": [
      "Production-ready NLP models",
      "Text processing pipelines",
      "Model training scripts",
      "Evaluation frameworks",
      "API implementations",
      "Performance benchmarks",
      "Documentation and guides",
      "Monitoring dashboards"
    ]
  },
  "configuration": {
    "mcpServers": [
      "filesystem",
      "github",
      "context7",
      "fetch"
    ],
    "slashCommands": [
      {
        "command": "/nlp-pipeline",
        "description": "Create NLP processing pipeline",
        "parameters": "[task] [languages] [requirements]",
        "example": "/nlp-pipeline sentiment-analysis \"en,es,fr\" \"real-time, aspect-based, >0.90 F1\""
      },
      {
        "command": "/nlp-model",
        "description": "Train or fine-tune NLP model",
        "parameters": "[model-type] [task] [data-path]",
        "example": "/nlp-model bert-base named-entity-recognition ./data/ner_corpus"
      },
      {
        "command": "/nlp-evaluate",
        "description": "Evaluate NLP model performance",
        "parameters": "[model-path] [test-data] [metrics]",
        "example": "/nlp-evaluate ./models/ner-v2 ./data/test.jsonl \"f1,precision,recall,bias\""
      }
    ],
    "environmentVariables": {
      "optional": [
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "HUGGINGFACE_TOKEN"
      ]
    }
  },
  "performanceMetrics": {
    "targets": {
      "f1Score": ">0.85",
      "inferenceLatency": "<100ms",
      "modelSize": "<1GB",
      "multilingualSupport": "10+ languages"
    },
    "monitoring": [
      "F1 score and accuracy",
      "Precision and recall",
      "Inference latency",
      "Model size",
      "Language coverage",
      "Bias metrics",
      "Error rates",
