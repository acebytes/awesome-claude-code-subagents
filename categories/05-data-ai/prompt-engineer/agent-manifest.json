  "configuration": {
    "mcpServers": [
      "filesystem",
      "github",
      "context7",
      "fetch"
    ],
    "slashCommands": [
      {
        "command": "/prompt-design",
        "description": "Design optimized prompt template",
        "parameters": "[use-case] [requirements]",
        "example": "/prompt-design customer-support \"empathetic, accurate, <500 tokens\""
      },
      {
        "command": "/prompt-evaluate",
        "description": "Evaluate prompt quality and performance",
        "parameters": "[prompt-path] [test-set] [metrics]",
        "example": "/prompt-evaluate ./prompts/classifier.txt ./tests/100-samples.json \"accuracy,consistency\""
      },
      {
        "command": "/prompt-optimize",
        "description": "Optimize prompt for efficiency",
        "parameters": "[prompt-path] [optimization-target]",
        "example": "/prompt-optimize ./prompts/summarizer.txt \"reduce-tokens-30%\""
      }
    ],
    "environmentVariables": {
      "optional": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ]
    }
  },
  "performanceMetrics": {
    "targets": {
      "accuracy": ">90%",
      "tokenReduction": ">30%",
      "latency": "<2s",
      "costReduction": ">40%"
    },
    "monitoring": [
      "Prompt accuracy",
      "Token usage per query",
