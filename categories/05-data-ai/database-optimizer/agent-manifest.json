  "capabilities": [
    "Query optimization achieving sub-100ms response times",
    "Execution plan analysis and optimization",
    "Strategic index design and maintenance",
    "Cache hit rate optimization to 90%+",
    "Lock contention reduction and resolution",
    "Database configuration tuning",
    "Replication lag minimization",
    "Resource utilization optimization",
    "Performance monitoring and alerting",
    "Scalability planning and implementation",
    "Multi-database system optimization (PostgreSQL, MySQL, MongoDB, Redis, etc.)",
    "Query rewriting and refactoring"
  ],
  "slashCommands": [
    {
      "command": "/db-analyze",
      "description": "Analyze query performance and database health",
      "usage": "/db-analyze [database_name] [options]",
      "workflow": [
        "Connect to database via MCP server",
        "Identify slow queries and bottlenecks",
        "Analyze execution plans (EXPLAIN/EXPLAIN ANALYZE)",
        "Review index usage and effectiveness",
        "Check cache hit ratios and buffer usage",
        "Examine lock contention and wait events",
        "Analyze I/O patterns and resource usage",
        "Generate comprehensive performance report with recommendations"
      ]
    },
    {
      "command": "/db-index",
      "description": "Recommend and implement optimal indexes",
      "usage": "/db-index <table_or_query> [options]",
      "workflow": [
        "Analyze query patterns and access paths",
        "Identify missing indexes causing table scans",
        "Review existing index usage statistics",
        "Design covering, partial, and expression indexes",
        "Consider multi-column index ordering",
        "Estimate index size and maintenance overhead",
        "Generate index creation statements",
        "Identify and recommend removal of redundant indexes",
        "Validate performance improvement"
      ]
    },
    {
      "command": "/db-tune",
      "description": "Tune database configuration for optimal performance",
      "usage": "/db-tune [database_system] [workload_type]",
      "workflow": [
        "Assess current configuration and resource allocation",
        "Analyze workload type (OLTP/OLAP/mixed)",
        "Optimize memory settings (buffer pool, cache, work memory)",
        "Tune checkpoint and WAL settings",
        "Configure connection pooling parameters",
        "Adjust autovacuum and maintenance settings",
        "Optimize parallel execution settings",
        "Set appropriate timeout and limit values",
        "Generate tuned configuration with explanations",
        "Document changes and expected impact"
      ]
    }
  ],
