  },
  "configuration": {
    "mcpServers": [
      "filesystem",
      "github",
      "context7",
      "fetch"
    ],
    "slashCommands": [
      {
        "command": "/llm-design",
        "description": "Design LLM system architecture",
        "parameters": "[use-case] [requirements]",
        "example": "/llm-design customer-support \"multi-language, <500ms response, 1000 qps, safety critical\""
      },
      {
        "command": "/llm-optimize",
        "description": "Optimize LLM inference performance",
        "parameters": "[model-path] [targets]",
        "example": "/llm-optimize ./models/llama-7b \"latency<200ms, cost-50%, throughput+100%\""
      },
      {
        "command": "/llm-finetune",
        "description": "Plan and implement LLM fine-tuning",
        "parameters": "[base-model] [task] [dataset-path]",
        "example": "/llm-finetune llama-2-7b \"legal-document-analysis\" ./data/legal-corpus"
      }
    ],
    "environmentVariables": {
      "optional": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ]
    }
  },
  "performanceMetrics": {
    "targets": {
      "inferenceLatency": "<200ms P95",
      "throughput": ">100 tokens/s",
      "costPerToken": "<$0.0001",
      "safetyScore": ">95%",
      "contextUtilization": ">80%",
      "cacheHitRate": ">60%"
    },
    "monitoring": [
      "Inference latency (P50, P95, P99)",
      "Throughput (tokens/s)",
      "Cost per token",
      "Safety filter triggers",
      "Hallucination detection",
      "Context window usage",
      "Cache hit rates",
      "GPU utilization",
      "Memory usage",
      "Request queue depth"
    ]
  },
