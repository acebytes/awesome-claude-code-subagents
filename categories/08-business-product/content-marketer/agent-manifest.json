  "slashCommands": [
    {
      "command": "/content-plan",
      "description": "Develop a comprehensive content strategy and editorial calendar",
      "parameters": [],
      "outputs": [
        "Target audience analysis and personas",
        "Competitive content landscape review",
        "Content pillars and topic clusters",
        "90-day editorial calendar",
        "Distribution channel strategy",
        "Performance KPIs and success metrics",
        "Resource allocation plan"
      ]
    },
    {
      "command": "/blog-draft",
      "description": "Create an SEO-optimized blog post draft",
      "parameters": [],
      "outputs": [
        "Keyword research and analysis",
        "SEO-optimized outline",
        "Complete blog post draft",
        "Meta title and description",
        "Internal linking suggestions",
        "Visual content recommendations",
        "CTA placement and copy"
      ]
    },
    {
      "command": "/seo-optimize",
      "description": "Optimize existing content for search engines and engagement",
      "parameters": [],
      "outputs": [
        "SEO audit and current performance",
        "Keyword opportunity analysis",
        "Optimized title tags and meta descriptions",
        "Improved content structure and headings",
        "Internal linking enhancements",
        "Schema markup recommendations",
        "Expected traffic impact estimation"
      ]
    },
    {
      "command": "/content-audit",
      "description": "Analyze content performance and identify optimization opportunities",
      "parameters": [],
      "outputs": [
        "Complete content inventory",
        "Traffic and engagement metrics analysis",
        "High and low performer identification",
        "SEO effectiveness assessment",
        "Content gap analysis",
        "Update and consolidation recommendations",
        "Prioritized action plan"
      ]
    }
  ],
  "mcpServers": [
    {
      "name": "filesystem",
      "purpose": "Manage content assets, drafts, and documentation",
      "keyFiles": [
        "content-calendar.md",
        "blog-drafts/*.md",
        "seo-research/*.csv",
        "campaign-briefs/*.md",
        "analytics-reports/*.json"
      ]
    },
    {
      "name": "github",
      "purpose": "Content workflow management and version control",
      "operations": [
        "Track content revisions",
        "Collaborate on drafts",
        "Review and approve content",
        "Publish workflow automation",
        "Campaign documentation"
      ]
    },
    {
      "name": "memory",
      "purpose": "Maintain marketing context and learnings",
      "storedInfo": [
        "Brand voice guidelines",
        "Audience insights",
        "Successful content patterns",
        "Campaign performance history",
        "Competitive intelligence"
      ]
    },
    {
      "name": "fetch",
      "purpose": "Content research and competitive analysis",
      "operations": [
        "Trending topic research",
        "Competitor content analysis",
        "Industry statistics gathering",
        "Brand mention monitoring",
        "Influencer research"
      ]
    }
  ],
  "performanceTargets": {
    "seoScore": "> 80/100",
    "engagementRate": "> 5%",
    "conversionRate": "> 2%",
    "contentROI": "> 300%",
    "trafficGrowth": "> 50% YoY",
    "leadQualityScore": "> 70/100"
  },
  "integrations": {
    "relatedAgents": [
